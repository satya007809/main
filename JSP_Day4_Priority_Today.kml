      <styleUrl>#addonPin</styleUrl>
      <Point><coordinates>81.827694,16.839139,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>5 · Guttula Veera Venkata Prasad (S.No 35)</name>
      <description>Venkatayapalem, Ramachandrapuram Mandal, Konaseema 533262 — EXACT pin (~35 km from Vegirouthu, on the way to Kakinada)</description>
      <styleUrl>#addonPin</styleUrl>
      <Point><coordinates>82.058528,16.771528,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🛏 Overnight · Kakinada (for Day 5 Visakhapatnam)</name>
      <styleUrl>#hotelPin</styleUrl>
      <Point><coordinates>82.247000,16.989000,0</coordinates></Point>
    </Placemark>

    <Placemark>
