<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>JSP Day 4 — Priority run today (from Samalkota)</name>
    <description>Today: 2 priority cases (Atukuri, Vegirouthu Suresh) plus the 3 delta-interior cases near them (Adimula, Kappala, Guttula). Deferred to next week's Vizag->Hyderabad NH-16 return: Chody (Rajahmundry) and Kasula (Tadepalligudem). Ends at Kakinada for Day 5 (Visakhapatnam). All pins exact. Import into Google My Maps for named pins.</description>

    <Style id="startPin">
      <IconStyle><color>ff2d9d0d</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/go.png</href></Icon></IconStyle>
    </Style>
    <Style id="priorityPin">
      <IconStyle><color>ff0000ff</color><scale>1.2</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-stars.png</href></Icon></IconStyle>
    </Style>
    <Style id="addonPin">
      <IconStyle><color>ff1e9e1e</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon></IconStyle>
    </Style>
    <Style id="hotelPin">
      <IconStyle><color>ff00a5ff</color><Icon><href>http://maps.google.com/mapfiles/kml/shapes/lodging.png</href></Icon></IconStyle>
    </Style>
    <Style id="routeLine">
      <LineStyle><color>ff8899d0</color><width>4</width></LineStyle>
    </Style>

    <Placemark>
      <name>START · Samalkota Railway Station</name>
      <styleUrl>#startPin</styleUrl>
      <Point><coordinates>82.170600,17.052400,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>1 ★ Atukuri Suresh Babu (S.No 41) — PRIORITY</name>
      <description>Gowripatnam Village, Devarapalli Mandal (FIR 75/2026, complainant Navya 9014443525) — EXACT pin</description>
      <styleUrl>#priorityPin</styleUrl>
      <Point><coordinates>81.618972,17.034694,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>2 · Adimula Venkateswara Rao (S.No 1)</name>
      <description>Thurupuvipparru village, Iragavaram Mandal, Tanuku, West Godavari — EXACT pin (~11 km from Vegirouthu)</description>
      <styleUrl>#addonPin</styleUrl>
      <Point><coordinates>81.733417,16.724833,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>3 ★ Vegirouthu Suresh (S.No 42) — PRIORITY</name>
