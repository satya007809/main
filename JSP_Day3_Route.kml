<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>JSP Day 3 — Konaseema &amp; Central East Godavari (from Palakollu)</name>
    <description>Field visit route for Day 3. Start: Palakollu (present location). 7 on-site customer visits in optimised serial order. Import this file into Google My Maps to see each customer's name on its pin.</description>

    <Style id="startPin">
      <IconStyle>
        <color>ff2d9d0d</color>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/go.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="stopPin">
      <IconStyle>
        <color>ff8899d0</color>
        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="routeLine">
      <LineStyle>
        <color>ff8899d0</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <Placemark>
      <name>START · Palakollu (Present location)</name>
      <description>Journey start point — West Godavari</description>
      <styleUrl>#startPin</styleUrl>
      <Point><coordinates>81.733,16.517,0</coordinates></Point>
    </Placemark>

