# ---- core
BID_ENVIRONMENT=production
BID_DATABASE_URL=postgresql+psycopg://bid:CHANGE_ME@db:5432/bharati
BID_PUBLIC_BASE_URL=https://api.your-domain.in
# generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
BID_JWT_SECRET=
# generate with: python -m app.cli gen-key   (keep a secure backup: losing it makes stored files unreadable)
BID_DATA_ENCRYPTION_KEY=
BID_ALLOW_REGISTRATION=true          # set false after creating your account
BID_STORAGE_DIR=/var/lib/bharati/storage

# ---- Claude API (server side only; never put this in the iOS app)
ANTHROPIC_API_KEY=
BID_AI_MODEL=claude-opus-5-5
BID_AI_DIGEST_MODEL=claude-opus-5-5   # e.g. claude-sonnet-5-5 to reduce per-document reading cost
BID_AI_EFFORT=high
BID_AI_SERVER_FALLBACK=true
BID_OCR_ENGINE=claude_vision           # claude_vision | tesseract | none

# ---- Google Drive OAuth (Google Cloud Console -> Credentials -> OAuth client "Web application")
# Authorised redirect URI: ${BID_PUBLIC_BASE_URL}/api/v1/connectors/google_drive/callback
BID_GOOGLE_CLIENT_ID=
BID_GOOGLE_CLIENT_SECRET=

# ---- OneDrive (Azure App registration), redirect: ${BID_PUBLIC_BASE_URL}/api/v1/connectors/onedrive/callback
BID_MICROSOFT_CLIENT_ID=
BID_MICROSOFT_CLIENT_SECRET=
BID_MICROSOFT_TENANT=common

# ---- operations
BID_RUN_WORKER_IN_PROCESS=true
BID_DEFAULT_RETENTION_DAYS=365
BID_SOFFICE_PATH=soffice
