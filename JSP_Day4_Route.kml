<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>JSP Day 4 — West-delta loop (from Samalkota)</name>
    <description>Day 4 field visits. Start: Samalkota Railway Station. One clean out-and-back loop: west along the top row, back east along the bottom row, ending at Ramachandrapuram — then overnight Kakinada, positioned for Day 5 (Visakhapatnam). All 7 pins are exact customer-shared locations. Import into Google My Maps to see customer names on each pin.</description>

    <Style id="startPin">
      <IconStyle><color>ff2d9d0d</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/go.png</href></Icon></IconStyle>
    </Style>
    <Style id="exactPin">
      <IconStyle><color>ff1e9e1e</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon></IconStyle>
    </Style>
    <Style id="hotelPin">
      <IconStyle><color>ff00a5ff</color><Icon><href>http://maps.google.com/mapfiles/kml/shapes/lodging.png</href></Icon></IconStyle>
    </Style>
    <Style id="routeLine">
      <LineStyle><color>ff8899d0</color><width>4</width></LineStyle>
    </Style>

    <Placemark>
      <name>START · Samalkota Railway Station</name>
      <description>Day 4 start point</description>
      <styleUrl>#startPin</styleUrl>
      <Point><coordinates>82.170600,17.052400,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>1 · Chody Lovaraju (S.No 5)</name>
      <description>Rajendra Nagar Street, Rajahmundry, East Godavari — EXACT pin shared by customer</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>81.790528,17.011861,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>2 · Atukuri Suresh Babu (S.No 41)</name>
      <description>Gowripatnam Village, Devarapalli Mandal (FIR 75/2026, complainant Navya 9014443525) — EXACT pin shared by customer</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>81.618972,17.034694,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>3 · Kasula Veera Venkata Rao (S.No 13)</name>
      <description>Krishnapuram village, Tadepalligudem Mandal, West Godavari 534101 — EXACT pin shared by customer</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>81.528000,16.887556,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>4 · Adimula Venkateswara Rao (S.No 1)</name>
      <description>Thurupuvipparru village, Iragavaram Mandal, Tanuku, West Godavari — EXACT pin shared by customer</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>81.733417,16.724833,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>5 · Vegirouthu Suresh (S.No 42)</name>
      <description>Ethakota / Ravulapalem Mandal (Avanti Frozen Foods GPAP, Emp 50149) — EXACT pin, family confirmed waiting at this location</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>81.813750,16.708111,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>6 · Kappala Krupanadham (S.No 11)</name>
      <description>Baduguvanilanka, Alamuru Mandal, Kothapeta, East Godavari — EXACT pin shared by customer</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>81.827694,16.839139,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>7 · Guttula Veera Venkata Prasad (S.No 35)</name>
      <description>Venkatayapalem, Ramachandrapuram Mandal, Konaseema 533262 — EXACT pin shared by customer</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>82.058528,16.771528,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🛏 Overnight · Kakinada (for Day 5 Visakhapatnam)</name>
      <description>Recommended overnight — proper city hotels, already pointed NE toward Vizag</description>
      <styleUrl>#hotelPin</styleUrl>
      <Point><coordinates>82.247000,16.989000,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Day 4 route line</name>
      <styleUrl>#routeLine</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          82.170600,17.052400,0
          81.790528,17.011861,0
          81.618972,17.034694,0
          81.528000,16.887556,0
          81.733417,16.724833,0
          81.813750,16.708111,0
          81.827694,16.839139,0
          82.058528,16.771528,0
          82.247000,16.989000,0
        </coordinates>
      </LineString>
    </Placemark>

  </Document>
