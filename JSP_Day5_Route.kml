<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>JSP Day 5 — Anakapalle rural cluster (from Kakinada)</name>
    <description>Day 5 field visits. Start: Kakinada (Hotel Sitara Elite). 4 confirmed rural cases in a clean loop around Anakapalle, resting at Anakapalle. Gulivindala (S.No 26, Vizag) is unconfirmed / not answering — shown as a float pin to pick up on the Day 6 Vizag leg. Import into Google My Maps for named pins.</description>

    <Style id="startPin">
      <IconStyle><color>ff2d9d0d</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/go.png</href></Icon></IconStyle>
    </Style>
    <Style id="exactPin">
      <IconStyle><color>ff1e9e1e</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon></IconStyle>
    </Style>
    <Style id="floatPin">
      <IconStyle><color>ff3399ff</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/ylw-stars.png</href></Icon></IconStyle>
    </Style>
    <Style id="hotelPin">
      <IconStyle><color>ff00a5ff</color><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/shapes/lodging.png</href></Icon></IconStyle>
    </Style>
    <Style id="routeLine">
      <LineStyle><color>ff8899d0</color><width>4</width></LineStyle>
    </Style>

    <Placemark>
      <name>START · Kakinada (Hotel Sitara Elite)</name>
      <styleUrl>#startPin</styleUrl>
      <Point><coordinates>82.235150,16.954979,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>1 · Bandi Apparao (S.No 12)</name>
      <description>Yelamanchili Mandal, Visakhapatnam — EXACT pin shared by customer (resolves earlier blank address)</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>82.883957,17.543797,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>2 · Pampana Aruna Kumar (S.No 19)</name>
      <description>Charakam / Theeda, Kasimkota Mandal, Anakapalli 531031 — EXACT pin shared by customer</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>82.820953,17.657658,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>3 · Pacchikura Nagaraju (S.No 17)</name>
      <description>Chinamadina village, Butchayyapeta Mandal, Anakapalli 531026 — EXACT pin shared by customer</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>82.861565,17.755236,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>4 · Doddi Rambabu (S.No 8)</name>
      <description>Maduthuru post, Atchutapuram Mandal, Anakapalli — EXACT pin shared by customer (resolves earlier Atchutapuram/Parwada ambiguity)</description>
      <styleUrl>#exactPin</styleUrl>
      <Point><coordinates>83.021027,17.559681,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>🛏 REST · Anakapalle (overnight)</name>
      <description>Your preferred rest base — central to the rural cluster, on NH-16</description>
      <styleUrl>#hotelPin</styleUrl>
      <Point><coordinates>82.998700,17.691300,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>⧗ FLOAT · Gulivindala Lakshman (S.No 26) — Vizag, unconfirmed</name>
      <description>Nakkavanipalem, Visakhapatnam — approx pin only, customer not answering. Pick up on the Day 6 Vizag leg, not part of today's loop.</description>
      <styleUrl>#floatPin</styleUrl>
      <Point><coordinates>83.300000,17.730000,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Day 5 route line</name>
      <styleUrl>#routeLine</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          82.235150,16.954979,0
          82.883957,17.543797,0
          82.820953,17.657658,0
          82.861565,17.755236,0
          83.021027,17.559681,0
          82.998700,17.691300,0
        </coordinates>
      </LineString>
    </Placemark>

  </Document>
</kml>
